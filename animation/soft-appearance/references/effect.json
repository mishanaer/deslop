    "motion": {
      "dependency": "motion",
      "import": "import { animate, cubicBezier } from 'motion/react'",
      "time_unit": "seconds",
      "call": "animate(element, propertyKeyframes, { delay, duration, ease })",
      "completion": "Await the returned controls and stop them during teardown."
    },
    "gsap": {
      "dependency": "gsap",
      "imports": [
