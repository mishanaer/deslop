{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "composite": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "incremental": false,
    "noEmit": false,
    "outDir": "./dist/types",
    "rootDir": "./src"
  },
  "include": [
    "src/index.ts",
    "src/toast.ts",
    "src/components/**/*.tsx",
    "src/hooks/**/*.ts",
    "src/lib/**/*.ts",
    "src/lib/**/*.tsx",
    "src/types/**/*.d.ts"
  ],
  "exclude": [
    "src/storybook/**",
    "src/App.tsx",
    "src/main.tsx"
  ]
}
