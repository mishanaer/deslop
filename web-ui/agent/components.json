{
  "schemaVersion": 2,
  "package": "@deslop/web-ui",
  "publicImportPattern": "@deslop/web-ui/{path}",
  "adoption": {
    "genericUiSource": "exclusive",
    "nativeControlPolicy": "replace",
    "visualOverridePolicy": {
      "allowed": ["layout", "position", "responsive-visibility"],
      "forbidden": [
        "color",
        "control-size",
        "internal-spacing",
        "radius",
        "shadow",
        "stroke",
        "typography"
      ]
    },
    "allowlist": {
      "requiredFields": ["rule", "file", "reason"],
      "optionalFields": ["line", "match", "owner", "expires"]
    }
  },
  "nativeControlReplacements": {
    "button": "components/button",
    "details": "components/accordion",
    "input": "components/input",
    "input[type=checkbox]": "components/checkbox",
    "input[type=radio]": "components/radio-group",
    "input[type=range]": "components/slider",
    "select": "components/native-select",
    "textarea": "components/textarea",
    "window.confirm": "components/alert-dialog"
  },
  "directDependencyReplacements": {
    "@radix-ui/*": "Use the matching @deslop/web-ui component",
    "radix-ui": "Use the matching @deslop/web-ui component",
    "cmdk": "components/command",
    "lucide-react": "@deslop/primitives/material-symbols-react",
    "sonner": "components/sonner"
  },
  "compoundContracts": [
    {
      "child": "RadioGroupItem",
      "ancestor": "RadioGroup",
      "module": "components/radio-group",
      "failureMode": "runtime"
    },
    {
      "child": "AccordionItem",
      "ancestor": "Accordion",
      "module": "components/accordion",
      "failureMode": "behavior"
    },
    {
      "child": "DialogContent",
      "ancestor": "Dialog",
      "module": "components/dialog",
      "failureMode": "behavior"
    },
    {
      "child": "FormField",
      "ancestor": "Form",
      "module": "components/form",
      "failureMode": "runtime"
    },
    {
      "child": "Sidebar",
      "ancestor": "SidebarProvider",
      "module": "components/sidebar",
      "failureMode": "runtime"
    }
  ],
  "deprecatedTokens": {
    "--background": "--background-primary",
    "--surface": "--background-secondary",
    "--elevation-90": "--primary-90",
    "--elevation-80": "--primary-80",
    "--elevation-70": "--primary-70",
    "--elevation-60": "--primary-60",
    "--elevation-50": "--primary-50",
    "--elevation-40": "--primary-40",
    "--elevation-30": "--primary-30",
    "--elevation-20": "--primary-20",
    "--elevation-10": "--primary-10",
    "--elevation-5": "--primary-5",
    "--elevation-4": "--primary-4"
  },
  "modules": [
    { "path": "components/accordion", "local": "ui/accordion", "category": "Layout" },
    { "path": "components/alert", "local": "ui/alert", "category": "Feedback" },
    { "path": "components/alert-dialog", "local": "ui/alert-dialog", "category": "Overlays" },
    { "path": "components/aspect-ratio", "local": "ui/aspect-ratio", "category": "Layout" },
    { "path": "components/attachment", "local": "ui/attachment", "category": "Data Display" },
    { "path": "components/avatar", "local": "ui/avatar", "category": "Data Display" },
    { "path": "components/badge", "local": "ui/badge", "category": "Data Display" },
    { "path": "components/breadcrumb", "local": "ui/breadcrumb", "category": "Navigation" },
    { "path": "components/bubble", "local": "ui/bubble", "category": "Data Display" },
    { "path": "components/button", "local": "ui/button", "category": "Inputs" },
    { "path": "components/button-group", "local": "ui/button-group", "category": "Inputs" },
    { "path": "components/calendar", "local": "ui/calendar", "category": "Inputs" },
    { "path": "components/card", "local": "ui/card", "category": "Layout" },
    { "path": "components/carousel", "local": "ui/carousel", "category": "Layout" },
    { "path": "components/chart", "local": "ui/chart", "category": "Data Display" },
    { "path": "components/checkbox", "local": "ui/checkbox", "category": "Inputs" },
    { "path": "components/collapsible", "local": "ui/collapsible", "category": "Layout" },
    { "path": "components/combobox", "local": "ui/combobox", "category": "Inputs" },
    { "path": "components/command", "local": "ui/command", "category": "Navigation" },
    { "path": "components/context-menu", "local": "ui/context-menu", "category": "Overlays" },
    { "path": "components/dialog", "local": "ui/dialog", "category": "Overlays" },
    { "path": "components/direction", "local": "ui/direction", "category": "Layout" },
    { "path": "components/drawer", "local": "ui/drawer", "category": "Overlays" },
    { "path": "components/dropdown-menu", "local": "ui/dropdown-menu", "category": "Overlays" },
    { "path": "components/empty", "local": "ui/empty", "category": "Feedback" },
    { "path": "components/field", "local": "ui/field", "category": "Inputs" },
    { "path": "components/form", "local": "ui/form", "category": "Inputs" },
