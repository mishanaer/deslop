    { "path": "components/input", "local": "ui/input", "category": "Inputs" },
    { "path": "components/input-group", "local": "ui/input-group", "category": "Inputs" },
    { "path": "components/input-otp", "local": "ui/input-otp", "category": "Inputs" },
    { "path": "components/item", "local": "ui/item", "category": "Data Display" },
    { "path": "components/kbd", "local": "ui/kbd", "category": "Data Display" },
    { "path": "components/label", "local": "ui/label", "category": "Inputs" },
    { "path": "components/marker", "local": "ui/marker", "category": "Data Display" },
    { "path": "components/menubar", "local": "ui/menubar", "category": "Navigation" },
    { "path": "components/message", "local": "ui/message", "category": "Data Display" },
    { "path": "components/message-scroller", "local": "ui/message-scroller", "category": "Layout" },
    { "path": "components/native-select", "local": "ui/native-select", "category": "Inputs" },
    { "path": "components/navigation-menu", "local": "ui/navigation-menu", "category": "Navigation" },
    { "path": "components/pagination", "local": "ui/pagination", "category": "Navigation" },
    { "path": "components/popover", "local": "ui/popover", "category": "Overlays" },
    { "path": "components/progress", "local": "ui/progress", "category": "Feedback" },
    { "path": "components/radio-group", "local": "ui/radio-group", "category": "Inputs" },
    { "path": "components/resizable", "local": "ui/resizable", "category": "Layout" },
    { "path": "components/scroll-area", "local": "ui/scroll-area", "category": "Layout" },
    { "path": "components/select", "local": "ui/select", "category": "Inputs" },
    { "path": "components/separator", "local": "ui/separator", "category": "Layout" },
    { "path": "components/sheet", "local": "ui/sheet", "category": "Overlays" },
