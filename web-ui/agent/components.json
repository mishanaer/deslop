    { "path": "components/spinner", "local": "ui/spinner", "category": "Feedback" },
    { "path": "components/switch", "local": "ui/switch", "category": "Inputs" },
    { "path": "components/table", "local": "ui/table", "category": "Data Display" },
    { "path": "components/tabs", "local": "ui/tabs", "category": "Navigation" },
    { "path": "components/textarea", "local": "ui/textarea", "category": "Inputs" },
    { "path": "components/toggle", "local": "ui/toggle", "category": "Inputs" },
    { "path": "components/toggle-group", "local": "ui/toggle-group", "category": "Inputs" },
    { "path": "components/tooltip", "local": "ui/tooltip", "category": "Overlays" },
    { "path": "blocks/dashboard", "local": "blocks/dashboard", "category": "Blocks" },
    { "path": "blocks/sidebar", "local": "blocks/sidebar", "category": "Blocks" },
    { "path": "blocks/login", "local": "blocks/login", "category": "Blocks" },
    { "path": "blocks/signup", "local": "blocks/signup", "category": "Blocks" },
    { "path": "charts/area", "local": "charts/area", "category": "Charts" }
  ]
}
