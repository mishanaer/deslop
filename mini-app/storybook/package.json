{
    "name": "deslop-mini-app-storybook",
    "private": true,
    "description": "Storybook and examples shipped with the local Mini App UI kit.",
    "type": "module",
    "packageManager": "yarn@4.5.3",
    "dependencies": {
        "@lisse/core": "0.5.2",
        "@lisse/react": "^0.5.2",
        "@tanstack/react-virtual": "^3.14.6",
        "calligraph": "^1.4.1",
        "clsx": "^2.1.1",
        "colorthief": "^3.4.0",
        "markdown-to-jsx": "9",
        "motion": "^12.42.2",
        "wouter": "^3.10.0"
    },
    "scripts": {
        "dev": "storybook dev -p 6006 --no-open",
        "storybook": "storybook dev -p 6006 --no-open",
        "build": "storybook build",
        "build:storybook": "storybook build",
        "lint": "yarn check:structure && yarn check:agent && yarn lint:js && yarn lint:css",
        "check:structure": "node scripts/check-styling.mjs",
        "check:agent": "node scripts/check-agent-kit.mjs",
        "check:primitives": "node ../../primitives/scripts/generate-layout-tokens.mjs --check && node ../../primitives/scripts/check-color-tokens.mjs && node ../../primitives/scripts/check-typography-tokens.mjs && node ../../primitives/scripts/generate-react-icons.mjs --check",
        "lint:js": "cd .. && storybook/node_modules/.bin/eslint --config storybook/eslint.config.mjs storybook/.storybook storybook/stories storybook/examples components hooks lib theme utils MiniAppProvider.js index.js",
        "lint:css": "stylelint '.storybook/**/*.css' 'examples/**/*.css' '../components/**/*.css' '../styles/**/*.css'",
        "format": "prettier --write '.storybook/**/*.{js,jsx,json,css}' 'examples/**/*.{js,jsx,json,css}' '../components/**/*.{js,jsx,json,css}' '../hooks/**/*.{js,jsx,json,css}' '../styles/**/*.css' --cache",
        "format:check": "prettier --check '.storybook/**/*.{js,jsx,json,css}' 'examples/**/*.{js,jsx,json,css}' '../components/**/*.{js,jsx,json,css}' '../hooks/**/*.{js,jsx,json,css}' '../styles/**/*.css' --cache",
        "verify": "yarn lint && yarn check:primitives && yarn build"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@storybook/react-vite": "^10.5.5",
        "@tailwindcss/vite": "^4.3.3",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "eslint": "^9",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.7.0",
        "prettier": "^3.9.5",
        "prop-types": "^15.8.1",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "storybook": "^10.5.5",
        "stylelint": "^17.14.0",
        "stylelint-config-standard": "^40.0.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.9.3",
        "vite": "7"
    }
}
